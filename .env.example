# FIFA 2026 Analytics Platform - environment variables
# Copy to .env and adjust as needed. Values here override config/config.yaml.

# Root-relative or absolute paths
FIFA_DATA_DIR=data
FIFA_DB_PATH=database/fifa_analytics.db

# Logging: DEBUG | INFO | WARNING | ERROR
FIFA_LOG_LEVEL=INFO

# Network
FIFA_HTTP_TIMEOUT=30
FIFA_HTTP_RETRIES=3
