# data/processed/*
# database/*.db
# database/*.sqlite3
# models/*.pkl
# models/*.joblib
# models/*.json
# models/*.cbm
!data/raw/.gitkeep
!data/processed/.gitkeep
!database/.gitkeep
!models/.gitkeep

# Notebooks
.ipynb_checkpoints/

# IDE / OS
.vscode/
.idea/
.DS_Store

# Logs
logs/*.log
!logs/.gitkeep
